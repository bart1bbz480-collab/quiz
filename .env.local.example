# Kopieer dit bestand naar .env.local en vul je Supabase-gegevens in.
# Vind deze waarden op: https://supabase.com/dashboard/project/<jouw-project>/settings/api

VITE_SUPABASE_URL=https://jouw-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key-hier

# Optioneel: app-versie voor sync-logging
VITE_APP_VERSION=0.1.0
